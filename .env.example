# ===== QuizMaster 环境变量样例 =====
# 复制为 .env 后按需修改；.env 已被 .gitignore 忽略，不要提交真实密钥。

# 运行环境：development | production
APP_ENV="development"
APP_HOST="127.0.0.1"
APP_PORT="8000"

# Session 签名密钥，生产环境必须替换为长随机串
SESSION_SECRET="change-me-to-a-long-random-string"

# 数据库（留空则使用 data/quizmaster.db）
DATABASE_URL=""

# 每题答题时间（秒）。仅 development 下可被 TEST_TIME_LIMIT_SECONDS 覆盖
QUESTION_TIME_LIMIT_SECONDS="60"
# 演示/录屏用的短时限，只在 APP_ENV=development 时生效
TEST_TIME_LIMIT_SECONDS=""

# ===== 奖励机制（研习积分 / 等级 / 成就）=====
REWARD_ENABLED="true"

# ===== 轻量 RAG（题目资料增强解析）=====
RAG_ENABLED="true"
# DeepSeek 的 Anthropic 兼容入口
AI_BASE_URL="https://api.deepseek.com/anthropic"
AI_API_KEY=""
AI_MODEL="deepseek-chat"
AI_TIMEOUT_SECONDS="8"

# ===== 排行榜演示账号（is_demo 账号默认不计入正式排行）=====
LEADERBOARD_INCLUDE_DEMO="true"
